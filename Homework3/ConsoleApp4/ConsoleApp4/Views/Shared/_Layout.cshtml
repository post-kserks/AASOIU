<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - Журналы и издательства</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="app-header">
        <div class="app-shell">
            <a class="brand" asp-controller="Publishers" asp-action="Index">Журналы и издательства</a>
            <nav class="nav">
                <a asp-controller="Publishers" asp-action="Index">Издательства</a>
                <a asp-controller="Magazines" asp-action="Index">Журналы</a>
                <a asp-controller="Reports" asp-action="Index">Отчёт</a>
            </nav>
        </div>
    </header>
    <main class="app-shell main">
        @if (TempData["StatusMessage"] is string statusMessage)
        {
            <div class="notice">@statusMessage</div>
        }
        @RenderBody()
    </main>
</body>
</html>
