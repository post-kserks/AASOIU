@model MagazineFormViewModel

@{
    ViewData["Title"] = "Редактировать журнал";
}

<section class="page-head">
    <div>
        <h1>Редактировать журнал</h1>
        <p>Измените поля основной таблицы.</p>
    </div>
</section>

<form asp-action="Edit" asp-route-id="@Model.Id" method="post" class="form">
    <input asp-for="Id" type="hidden" />
    <div asp-validation-summary="ModelOnly" class="validation"></div>

    <label asp-for="Name"></label>
    <input asp-for="Name" autofocus />
    <span asp-validation-for="Name" class="validation"></span>

    <label asp-for="PublisherId"></label>
    <select asp-for="PublisherId" asp-items="Model.Publishers">
        <option value="0">Выберите издательство</option>
    </select>
    <span asp-validation-for="PublisherId" class="validation"></span>

    <label asp-for="CirculationK"></label>
    <input asp-for="CirculationK" type="number" min="0" />
    <span asp-validation-for="CirculationK" class="validation"></span>

    <div class="form-actions">
        <button class="button primary" type="submit">Сохранить</button>
        <a class="button" asp-action="Index">Отмена</a>
    </div>
</form>
